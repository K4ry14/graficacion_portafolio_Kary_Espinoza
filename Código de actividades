/*
  =======================================================
     ACTIIVIDAD 1.1: GEOMETRÍA Y PRIMITIVAS DE LIENZO
  =======================================================
  
*/

function setup() {
  createCanvas(400, 400);
  background('purple');
  fill('0, 128, 0');
  rectMode(CENTER);
}

function draw() {
 
  let x = width / 2;
  let y = height / 2;

  fill(180);
  rect(x, y + 40, 80, 90, 10);

  fill(200);
  rect(x, y - 60, 60, 60, 8);
  fill(255);
  ellipse(x - 15, y - 65, 20, 20);
  ellipse(x + 15, y - 65, 20, 20);

  fill(0);
  let pupilOffsetX = constrain(mouseX - x, -5, 5);
  let pupilOffsetY = constrain(mouseY - (y - 65), -5, 5);
  ellipse(x - 15 + pupilOffsetX, y - 65 + pupilOffsetY, 4, 0);
  ellipse(x + 15 + pupilOffsetX, y - 65 + pupilOffsetY, 4, 0);
  
  stroke(51, 119, 255);
  line(x - 15, y - 45, x + 15, y - 45);
  
  stroke(191,128,255);
  strokeWeight(6);
  line(x - 50, y + 15, x - 90, y - 20);
  line(x + 50, y + 15, x + 90, y - 20);

  strokeWeight(8);
  line(x - 25, y + 95, x - 30, y + 120);
  line(x + 25, y + 95, x + 30, y + 120);
}
/*
  =======================================================
     ACTIVIDAD 1.2: ESTILOS, PALETAS Y TRANSPARENCIAS
  =======================================================
  
*/
function setup() {
  createCanvas(400, 400);
  background('purple');
  fill('0, 128, 0');
  rectMode(CENTER);
}

function draw() {
  let x = width / 2;
  let y = height / 2;

  // Se agrego noStroke() para quitar el contorno del cuerpo
  noStroke();
  fill(180);
  rect(x, y + 40, 80, 90, 10);

  // Se movio la instruccion de color para probar la renderizacion
  rect(x, y - 60, 60, 60, 8);

  fill(255);
  ellipse(x - 15, y - 65, 20, 20);
  ellipse(x + 15, y - 65, 20, 20);

  fill(0);
  let pupilOffsetX = constrain(mouseX - x, -5, 5);
  let pupilOffsetY = constrain(mouseY - (y - 65), -5, 5);
  ellipse(x - 15 + pupilOffsetX, y - 65 + pupilOffsetY, 4, 0);
  ellipse(x + 15 + pupilOffsetX, y - 65 + pupilOffsetY, 4, 0);

  stroke(51, 119, 255);
  line(x - 15, y - 45, x + 15, y - 45);

  // Se agrego noFill() para quitar el relleno en esta seccion
  noFill();
  stroke(191,128,255);
  strokeWeight(6);
  line(x - 50, y + 15, x - 90, y - 20);
  line(x + 50, y + 15, x + 90, y - 20);

  // Se agrego un cuarto parametro (120) para dar transparencia alfa
  fill(0, 255, 200, 120);
  noStroke();
  rect(x, y - 60, 70, 30, 5);

  strokeWeight(8);
  stroke(0);
  line(x - 25, y + 95, x - 30, y + 120);
  line(x + 25, y + 95, x + 30, y + 120);
}
